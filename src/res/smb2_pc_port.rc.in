// Windows resources for smb2_pc_port.exe (generated by CMake from
// src/res/smb2_pc_port.rc.in): Explorer icon + VERSIONINFO.
// The icon is the generic installer icon (installer/smb2.ico, no game
// artwork); the window/taskbar icon is still made from the user's disc at
// runtime (disc_icon.c).
#include <winver.h>

1 ICON "@SMB2_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @SMB2_VER_COMMA@
 PRODUCTVERSION  @SMB2_VER_COMMA@
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "unofficial PC port"
            VALUE "FileDescription",  "SMB2"
            VALUE "FileVersion",      "@SMB2_VERSION@"
            VALUE "InternalName",     "smb2_pc_port"
            VALUE "OriginalFilename", "smb2_pc_port.exe"
            VALUE "ProductName",      "SMB2"
            VALUE "ProductVersion",   "@SMB2_VERSION@"
            VALUE "Comments",         "Unofficial, non-commercial PC port. Needs your own GameCube disc image; no game content included."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
