# Generates build_id_gen.h (+ build_id.txt) for src/platform/build_id.c.
# Run as:  cmake -DSRC_DIR=<repo> -DOUT_DIR=<dir> -P build_id.cmake
# Build id = <git commit count>-<short sha>[+dirty]; without git: UTC timestamp.
# Files are only touched when the content changes (copy_if_different), so a
# rebuild with the same HEAD recompiles nothing.
set(_count "")
set(_sha "")
set(_dirty "")
set(_gits git git.exe)   # git.exe: a worktree's .git file holds a Windows path, unreadable by WSL git
foreach(_g IN LISTS _gits)
    if(_count STREQUAL "")
        execute_process(COMMAND ${_g} rev-list --count HEAD WORKING_DIRECTORY "${SRC_DIR}"
                        OUTPUT_VARIABLE _c RESULT_VARIABLE _r1 ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        execute_process(COMMAND ${_g} rev-parse --short=7 HEAD WORKING_DIRECTORY "${SRC_DIR}"
                        OUTPUT_VARIABLE _s RESULT_VARIABLE _r2 ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(_r1 EQUAL 0 AND _r2 EQUAL 0 AND _c MATCHES "^[0-9]+$" AND _s MATCHES "^[0-9a-f]+$")
            set(_count "${_c}")
            set(_sha "${_s}")
            # tracked files only: scratch files in the tree don't count.  `diff` compares
            # content (diff-index trips over stat changes), and core.autocrlf=true makes WSL
            # git read the Windows checkout's CRLF files the way Windows git does.
            execute_process(COMMAND ${_g} -c core.autocrlf=true diff --quiet HEAD -- WORKING_DIRECTORY "${SRC_DIR}"
                            RESULT_VARIABLE _rd ERROR_QUIET OUTPUT_QUIET)
            if(NOT _rd EQUAL 0)
                set(_dirty "+dirty")
            endif()
        endif()
    endif()
endforeach()
if(_count STREQUAL "")
    string(TIMESTAMP _count "%Y%m%d%H%M" UTC)
    set(_sha "nogit")
endif()
set(_id "${_count}-${_sha}${_dirty}")
file(MAKE_DIRECTORY "${OUT_DIR}")
file(WRITE "${OUT_DIR}/build_id_gen.h.tmp"
"/* generated by cmake/build_id.cmake - do not edit */
#define SMB2_BUILD_ID_STR \"${_id}\"
#define SMB2_BUILD_NUMBER_STR \"${_count}\"
#define SMB2_BUILD_SHA_STR \"${_sha}${_dirty}\"
")
file(WRITE "${OUT_DIR}/build_id.txt.tmp" "${_id}\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT_DIR}/build_id_gen.h.tmp" "${OUT_DIR}/build_id_gen.h")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT_DIR}/build_id.txt.tmp" "${OUT_DIR}/build_id.txt")
